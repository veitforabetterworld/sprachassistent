{
  "name": "@sprachassistent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/migrate.ts && tsx watch src/index.ts",
    "migrate": "node dist/migrate.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@veit/api-keys": "workspace:*",
    "@veit/auth-server": "workspace:*",
    "@veit/db": "workspace:*",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
