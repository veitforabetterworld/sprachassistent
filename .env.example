# Vorlage fuer .env im Repo-Root. Alles andere (KI-Anbieter, ESP-Schluessel, Geraete, SMTP) wird im
# Adminbereich eingestellt und liegt in der Datenbank.

# --- Self-Hosting mit docker compose ---
POSTGRES_PASSWORD=
# Verschluesselt MCP-Tokens, OAuth-Refresh-Tokens und KI-Anbieter-Keys (AES-256-GCM). openssl rand -hex 32
CREDENTIALS_KEY=
# Domain fuer HTTPS (Zertifikat automatisch, Ports 80/443 muessen erreichbar sein); leer = http im Heimnetz
# SITE=assistent.example.de
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Entwicklung ohne Docker (pnpm dev:api, cargo run) ---
DATABASE_URL=postgres://sprachassistent:sprachassistent@localhost:5432/sprachassistent

# Optional, Standardwerte:
# API_HOST=127.0.0.1       Rust-Sprachserver
# API_PORT=3020
# MODELS_DIR=models
# WEB_API_HOST=127.0.0.1   Node-Web-API
# WEB_API_PORT=3022
# VOICE_URL=http://127.0.0.1:3020
# SEARXNG_URL=http://127.0.0.1:8888   selbstgehostetes SearXNG fuer die Internetrecherche (JSON-Format an)
# BROWSER_BIN=                        Chromium fuer Seiten mit JavaScript, leer: /usr/bin/chromium falls vorhanden
# BROWSER_USER=sprachassistent-browser  Konto, unter dem Chromium laeuft, wenn der Server root ist
