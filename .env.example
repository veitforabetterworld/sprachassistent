# Vorlage fuer .env im Repo-Root. Auf dem Pi legt deployments/pi/bootstrap.sh die .env an.

API_HOST=127.0.0.1
# 3000 = plenivo, 3001 = hochwasserdienst
API_PORT=3020
# Schluessel, den der ESP32 als "Authorization: Bearer ..." schickt. Erzeugen: openssl rand -hex 24
# Leer = keine Pruefung (nur fuer Tests im Heimnetz).
API_KEY=

DATA_DIR=data

# Spracherkennung (whisper.cpp). deployments/pi/download-models.sh laedt das Modell.
WHISPER_MODEL=models/whisper/ggml-small-q5_1.bin
WHISPER_THREADS=4
WHISPER_BEAM_SIZE=1
WHISPER_LANGUAGE=de

# Sprachausgabe (Piper-Stimme im sherpa-onnx-Format, tokens.txt und espeak-ng-data liegen daneben).
PIPER_MODEL=models/vits-piper-de_DE-thorsten-medium/de_DE-thorsten-medium.onnx
PIPER_THREADS=2
# < 1.0 langsamer, > 1.0 schneller
PIPER_SPEED=1.0

# KI-Anbieter in Reihenfolge; faellt einer aus, wird der naechste genommen.
LLM_PROVIDERS=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional lokal: LLM_PROVIDERS=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# Gedaechtnis
HISTORY_MESSAGES=12
# Nach jedem Gespraech Fakten herausziehen (kostet eine zusaetzliche KI-Anfrage).
MEMORY_EXTRACTION=true

RUST_LOG=info
