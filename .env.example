# Vorlage fuer .env im Repo-Root. Auf dem Pi legt deployments/pi/bootstrap.sh die .env an.
# Nur die Datenbank-Verbindung ist Pflicht; alles andere (KI-Anbieter, ESP-Schluessel, Geraete, SMTP,
# Spracherkennung) wird im Adminbereich eingestellt und liegt in der Datenbank.

DATABASE_URL=postgres://sprachassistent:sprachassistent@localhost:5432/sprachassistent

# Verschlüsselt MCP-Tokens, OAuth-Refresh-Tokens und KI-Anbieter-Keys (AES-256-GCM, Präfix enc1:).
# Ohne diesen Wert bleiben neue Geheimnisse im Klartext. openssl rand -hex 32
# CREDENTIALS_KEY=

# Optional, Standardwerte:
# API_HOST=127.0.0.1       Rust-Sprachserver
# API_PORT=3020
# MODELS_DIR=models
# WEB_API_HOST=127.0.0.1   Node-Web-API
# WEB_API_PORT=3022
# VOICE_URL=http://127.0.0.1:3020
